<template>
  <div class="page">
    <div class="header">
      <text class="t-back" style="font-size: {{fs(15, fontTick)}}px" @click="goHome">首页</text>
      <text class="t-title" style="font-size: {{fs(17, fontTick)}}px">抽词条</text>
      <text class="t-back" style="font-size: {{fs(15, fontTick)}}px" @click="goCodex">图鉴</text>
    </div>

    <div class="status">
      <text class="t-status" style="font-size: {{fs(13, fontTick)}}px">抽天赋：选 {{picked.length}}/3</text>
      <text class="t-sub" style="font-size: {{fs(12, fontTick)}}px">共 {{total}} 条词条</text>
    </div>

    <div class="grid">
      <div class="card {{$item.cls}}" for="{{cards}}" tid="id" @click="toggle($item.id)">
        <text class="card-name r{{$item.rarity}}" style="color: #e8e8e8; font-size: {{fs(15, fontTick)}}px">{{$item.name}}</text>
        <text class="card-tag" style="color: {{$item.tagColor}}; font-size: {{fs(10, fontTick)}}px">{{$item.tagText}}</text>
      </div>
    </div>

    <div class="desc">
      <text class="t-sub" style="font-size: {{fs(12, fontTick)}}px">{{descText}}</text>
    </div>

    <div class="btn-row">
      <div class="btn btn-quiet" style="width: 84px;" @click="redraw">
        <text class="t-btn" style="font-size: {{fs(15, fontTick)}}px">换一批</text>
      </div>
      <div class="v-gap"></div>
      <div class="btn {{picked.length === 3 ? 'btn-primary' : 'btn-quiet'}} grow" @click="next">
        <text class="t-btn" style="font-size: {{fs(15, fontTick)}}px">{{picked.length === 3 ? '下一步 · 分配属性' : '再选 ' + (3 - picked.length) + ' 个'}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { fs, ensureScale } from '../../common/core/ui'
import { setContent, newRun, drawTalents, chooseTalents, counts, RARITY_NAME, talentById } from '../../common/core/engine'

/** 词条若是"体系门票"，就在卡片上标出体系名与配色 */
const PATH_TAG = {
  body: { name: '炼体', color: '#ff8a65' },
  magic: { name: '魔法', color: '#7fb3ff' },
  tech: { name: '科技', color: '#6fcf97' },
  cultivate: { name: '修仙', color: '#bb86fc' }
}

function pathTagOf(t) {
  const e = t.eff || {}
  if (e.spiritRoot) return e.dualPath ? { name: '双修', color: '#ffc857' } : PATH_TAG.cultivate
  if (e.enterPath) return e.dualPath ? { name: '双修', color: '#ffc857' } : (PATH_TAG[e.enterPath] || null)
  if (e.dualPath) return { name: '双修', color: '#ffc857' }
  return null
}

function rarityColor(r) {
  return r === 4 ? '#ffc857' : (r === 3 ? '#bb86fc' : (r === 2 ? '#6fcf97' : '#c8cdd4'))
}

export default {
  fs: fs,

  private: {
    fontTick: 0,
    cards: [],
    picked: [],
    descText: '点词条看说明，最多选 3 个',
    total: 0
  },

  onInit() {
    ensureScale(() => { this.fontTick++ })
    setContent(this.$app.$def.CONTENT)
    this.total = counts().talents
    this.roll()
  },

  roll() {
    const run = newRun()
    this.$app.$def.run = run
    this.picked = []
    const cands = drawTalents(run, Math.min(10, counts().talents))
    this.cards = cands.map(t => {
      const tag = pathTagOf(t)
      return {
        id: t.id,
        name: t.name,
        rarity: t.rarity,
        rarityName: RARITY_NAME[t.rarity],
        tagText: tag ? tag.name : RARITY_NAME[t.rarity],
        tagColor: tag ? tag.color : rarityColor(t.rarity),
        cls: 'card'
      }
    })
    this.descText = '点词条看说明，最多选 3 个'
  },

  toggle(id) {
    this.$app.$def.tap()
    const i = this.picked.indexOf(id)
    if (i >= 0) {
      this.picked.splice(i, 1)
    } else {
      if (this.picked.length >= 3) {
        this.descText = '最多选 3 个，先取消一个'
        return
      }
      this.picked.push(id)
    }
    const t = this.cards.filter(c => c.id === id)[0]
    const full = this.fullOf(id)
    if (t && full) this.descText = full.name + '（' + t.rarityName + '）' + full.desc
    this.refresh()
  },

  fullOf(id) { return talentById(id) },

  refresh() {
    this.cards = this.cards.map(c => ({
      id: c.id, name: c.name, rarity: c.rarity, rarityName: c.rarityName,
      tagText: c.tagText, tagColor: c.tagColor,
      cls: this.picked.indexOf(c.id) >= 0 ? 'card card-on' : 'card'
    }))
  },

  redraw() {
    this.$app.$def.tap()
    this.roll()
  },

  next() {
    if (this.picked.length !== 3) return
    this.$app.$def.tap()
    const run = this.$app.$def.run
    chooseTalents(run, this.picked)
    // 用 replace：抽完词条这一步不该再回来，push 会让上一局/上一页留在页面栈里，
    // 每页一个 VM，玩几局就把手环内存堆光了（重启的主因之一）。
    router.replace({ uri: 'pages/alloc' })
  },

  goCodex() { router.push({ uri: 'pages/codex' }) },
  goHome() { router.replace({ uri: 'pages/home' }) }
}
</script>

<style>
  @import '../../common/style/base.css';

  .grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    width: 100%;
    flex: 1;
    margin-top: 6px;
  }

  .card {
    width: 80px;
    height: 44px;
    margin: 3px;
    border-radius: 10px;
    background-color: rgba(120, 120, 121, 0.2);
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .card-on {
    background-color: rgba(76, 175, 80, 0.85);
  }

  .card-name { text-align: center; width: 100%; }
  .card-tag { text-align: center; width: 100%; }

  .r1 { color: #c8cdd4; }
  .r2 { color: #6fcf97; }
  .r3 { color: #bb86fc; }
  .r4 { color: #ffc857; }

  .desc {
    width: 100%;
    height: 34px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding-left: 4px;
    padding-right: 4px;
  }
</style>
