<template>
  <div class="page">
    <div class="header">
      <text class="t-back" style="font-size: {{fs(15, fontTick)}}px; width: 20px"></text>
      <text class="t-title" style="font-size: {{fs(17, fontTick)}}px">人生重开·修仙</text>
      <text class="t-back" style="font-size: {{fs(15, fontTick)}}px; width: 20px"></text>
    </div>

    <div class="sub">
      <text class="t-sub" style="font-size: {{fs(11, fontTick)}}px">四条修炼体系 · 约 2400 条原创内容</text>
    </div>

    <div class="menu">
      <div class="menu-item menu-start" @click="start">
        <text class="menu-t" style="font-size: {{fs(16, fontTick)}}px">开始人生</text>
        <text class="menu-s" style="font-size: {{fs(11, fontTick)}}px">抽词条 → 分配属性</text>
      </div>

      <div class="menu-item" @click="goCodex">
        <text class="menu-t" style="font-size: {{fs(16, fontTick)}}px">词条图鉴</text>
        <text class="menu-s" style="font-size: {{fs(11, fontTick)}}px">{{codexText}}</text>
      </div>

      <div class="menu-item" @click="goMore">
        <text class="menu-t" style="font-size: {{fs(16, fontTick)}}px">更多设置</text>
        <text class="menu-s" style="font-size: {{fs(11, fontTick)}}px">字号 · 播放速度 · 玩法说明</text>
      </div>
    </div>

    <div class="foot">
      <text class="t-info" style="font-size: {{fs(11, fontTick)}}px">作者 模糊二维码byxz</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { fs, ensureScale } from '../../common/core/ui'
import { setContent, counts } from '../../common/core/engine'

export default {
  fs: fs,

  private: {
    fontTick: 0,
    codexText: ''
  },

  onInit() {
    ensureScale(() => { this.fontTick++ })
    setContent(this.$app.$def.CONTENT)
    this.refresh()
  },

  // 从图鉴/设置返回时刷新收集进度
  onShow() { this.refresh() },

  refresh() {
    const c = counts()
    const s = this.$app.$def.codexSeen || {}
    const total = c.talents + c.items + c.endings + c.achievements
    const got = (s.T || []).length + (s.I || []).length + (s.D || []).length + (s.A || []).length
    this.codexText = '已收集 ' + got + ' / ' + total + ' 条'
  },

  // 进入下一阶段一律用 replace：push 会把旧页留在页面栈里，每页一个 JS 虚拟机，
  // 在手环上几个回合就把内存堆光了（重启的主因之一）。
  start() {
    this.$app.$def.tap()
    router.replace({ uri: 'pages/index' })
  },

  // 图鉴/设置是可以返回的，用 push
  goCodex() {
    this.$app.$def.tap()
    router.push({ uri: 'pages/codex' })
  },

  goMore() {
    this.$app.$def.tap()
    router.push({ uri: 'pages/more' })
  }
}
</script>

<style>
  @import '../../common/style/base.css';

  .sub {
    width: 100%;
    height: 20px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .menu {
    width: 100%;
    flex: 1;
    flex-direction: column;
    justify-content: center;
  }

  .menu-item {
    width: 100%;
    height: 62px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 10px;
    border-radius: 12px;
    background-color: rgba(120, 120, 121, 0.22);
  }

  .menu-start { background-color: rgba(76, 175, 80, 0.85); }

  .menu-t { color: #f0e6d2; width: 100%; }
  .menu-s { color: #8b8f96; width: 100%; margin-top: 3px; }

  .foot {
    width: 100%;
    height: 22px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
