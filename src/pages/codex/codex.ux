<template>
  <div class="page" style="padding-top: {{padTop}}px; padding-bottom: {{padBottom}}px; padding-left: {{padSide}}px; padding-right: {{padSide}}px">
    <div class="header">
      <text class="t-back" style="font-size: {{fs(15, fontTick)}}px" @click="back">返回</text>
      <text class="t-title" style="font-size: {{fs(17, fontTick)}}px">词条图鉴</text>
      <text class="t-back" style="font-size: {{fs(15, fontTick)}}px" @click="clearSeen">清空</text>
    </div>

    <div class="tabs">
      <div class="tab {{tab === $item.k ? 'tab-on' : ''}}" for="{{tabs}}" tid="k" @click="setTab($item.k)">
        <text class="tab-t" style="font-size: {{fs(10, fontTick)}}px">{{$item.name}}</text>
      </div>
    </div>

    <div class="filters" if="{{showFilter}}">
      <div class="filter {{flt === $item.k ? 'filter-on' : ''}}" for="{{filters}}" tid="k" @click="setFilter($item.k)">
        <text class="filter-t" style="font-size: {{fs(11, fontTick)}}px">{{$item.name}}</text>
      </div>
    </div>

    <div class="status">
      <text class="t-sub" style="font-size: {{fs(11, fontTick)}}px">{{hint}}</text>
    </div>

    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="row" for="{{pageList}}" tid="id">
        <text class="row-name {{$item.locked ? 'locked' : 'r' + $item.rarity}}" style="color: #e8e8e8; font-size: {{fs(13, fontTick)}}px">{{$item.show}}</text>
        <text class="row-desc {{$item.locked ? 'locked' : ''}}" style="color: #e8e8e8; font-size: {{fs(11, fontTick)}}px">{{$item.desc}}</text>
        <text class="row-note" style="color: #8b8f96; font-size: {{fs(10, fontTick)}}px">{{$item.note}}</text>
      </div>
    </scroll>

    <div class="pager" if="{{showPager}}">
      <div class="pg-btn" @click="prevPage">
        <text class="pg-t" style="font-size: {{fs(13, fontTick)}}px">上一页</text>
      </div>
      <text class="pg-n" style="font-size: {{fs(12, fontTick)}}px">{{pageText}}</text>
      <div class="pg-btn" @click="nextPage">
        <text class="pg-t" style="font-size: {{fs(13, fontTick)}}px">下一页</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { fs, ensureScale } from '../../common/core/ui'
import { setContent, codex, RARITY_NAME, PATH_LIST, effText, reqText } from '../../common/core/engine'
import { saveKey } from '../../common/core/util'

// 图鉴条目上千条：一屏全渲染会一次创建上千个原生控件，手环直接看门狗重启。
// 每页只渲染 PAGE_SIZE 条，翻页看其余。
const PAGE_SIZE = 40

// 六个分类各一个标签。标签名统一两字，宽度按 176px 可用宽度反算：
// 6 × 28 = 168px 才装得下（早前 5 个 42px = 210px 是超宽的）。
const TABS = [
  { k: 'P', name: '体系' },
  { k: 'T', name: '词条' },
  { k: 'E', name: '事件' },
  { k: 'I', name: '物品' },
  { k: 'D', name: '结局' },
  { k: 'A', name: '成就' }
]

export default {
  fs: fs,

  private: {
    padTop: 30,
    padBottom: 32,
    padSide: 18,
    fontTick: 0,
    tab: 'T',
    tabs: TABS,
    filters: [],
    flt: 'all',
    showFilter: true,
    pool: [],         // 分类下的完整列表（不直接渲染）
    pageList: [],     // 当前页真正渲染的行
    pg: 0,
    pageText: '',
    showPager: false,
    hint: ''
  },

  syncPad() {
    const app = this.$app.$def
    this.padTop = app.padTop
    this.padBottom = app.padBottom
    this.padSide = app.padSide
  },

  onInit() {
    this.syncPad();
    ensureScale(() => { this.fontTick++ })
    setContent(this.$app.$def.CONTENT)
    this.filters = [
      { k: 'all', name: '全部' },
      { k: 'got', name: '已得' },
      { k: 'lock', name: '未得' }
    ]
    this.rebuild()
  },

  // 从别的页面返回时也刷新（图鉴进度可能变了）
  onShow() {
    this.syncPad(); this.rebuild() },

  seen() {
    const c = this.$app.$def.codexSeen
    return c || { T: [], I: [], D: [], A: [], P: [] }
  },

  /** 分类计数 + 列表一次重建；任何异常都兜住，保证页面能打开 */
  rebuild() {
    try {
      this.buildTabs()
      this.buildList()
    } catch (e) {
      this.hint = '图鉴载入出错：' + (e && e.message ? e.message : e)
    }
  },

  buildTabs() {
    const cx = codex()
    const s = this.seen()
    const count = {
      P: (s.P || []).length,
      T: (s.T || []).length,
      I: (s.I || []).length,
      D: (s.D || []).length,
      A: (s.A || []).length,
      E: 0
    }
    this.tabs = TABS.map(t => ({ k: t.k, name: t.name, seen: count[t.k] }))
    if (this.tab === 'E') {
      this.showFilter = false
      this.hint = '事件 ' + cx.events.length + ' 条 · 写明触发条件与效果'
    } else if (this.tab === 'P') {
      this.showFilter = false
      this.hint = '体系 ' + count.P + ' / ' + PATH_LIST.length + ' 走过'
    } else {
      this.showFilter = true
      this.hint = this.tabName() + ' ' + count[this.tab] + ' / ' + this.tabTotal(cx)
    }
  },

  tabName() {
    for (let i = 0; i < TABS.length; i++) if (TABS[i].k === this.tab) return TABS[i].name
    return ''
  },

  tabTotal(cx) {
    if (this.tab === 'T') return cx.talents.length
    if (this.tab === 'I') return cx.items.length
    if (this.tab === 'D') return cx.endings.length
    if (this.tab === 'A') return cx.achievements.length
    return 0
  },

  setTab(k) {
    this.$app.$def.tap()
    this.tab = k
    this.flt = 'all'
    this.rebuild()
  },

  setFilter(k) {
    this.$app.$def.tap()
    this.flt = k
    this.buildList()
  },

  buildList() {
    const cx = codex()
    const s = this.seen()
    const out = []

    if (this.tab === 'P') {
      const walked = s.P || []
      for (let i = 0; i < PATH_LIST.length; i++) {
        const d = PATH_LIST[i]
        const got = walked.indexOf(d.key) >= 0
        out.push({
          id: 'P_' + d.key,
          locked: !got,
          show: got ? d.name : '？？？',
          desc: got ? ('入门：' + d.root + ' ｜ 资源 ' + d.res + ' / 本命 ' + d.sp) : '尚未走过这条体系',
          note: got ? d.ladder.map(x => x.name).join(' → ') : '',
          rarity: 4
        })
      }
      this.setPool(out)
      return
    }

    if (this.tab === 'E') {
      const src = cx.events || []
      for (let i = 0; i < src.length; i++) {
        const e = src[i]
        const age = e.age ? (e.age[0] + '-' + e.age[1] + ' 岁') : ''
        out.push({
          id: e.id,
          locked: false,
          show: (e.title || '日常') + (age ? '　' + age : ''),
          desc: '条件：' + reqText(e.req) + ' ｜ 效果：' + (effText(e.eff) || '无属性变化'),
          note: e.text || '',
          rarity: 1
        })
      }
      this.setPool(out)
      return
    }

    const keys = { T: 'talents', I: 'items', D: 'endings', A: 'achievements' }
    const src = cx[keys[this.tab]] || []
    const got = s[this.tab] || []
    for (let i = 0; i < src.length; i++) {
      const e = src[i]
      const locked = got.indexOf(e.id) < 0
      if (locked) {
        out.push({ id: e.id, locked: true, show: '？？？', desc: '尚未解锁', note: '', rarity: e.rarity || e.rank || 1 })
        continue
      }
      // 已解锁的显示 效果 + 条件 + 原文，让"为什么发生"看得见
      let show = e.name
      let desc = ''
      let note = e.desc || ''
      if (this.tab === 'T') {
        show = e.name + (e.rarity ? '（' + RARITY_NAME[e.rarity] + '）' : '')
        desc = '效果：' + (effText(e.eff) || '无属性变化')
      } else if (this.tab === 'I') {
        show = (e.kind ? e.kind + '·' : '') + e.name
        desc = '效果：' + (effText(e.eff) || '无')
        note = e.desc || ''
      } else {
        show = e.name + (e.rank ? '（' + RARITY_NAME[e.rank] + '）' : '')
        desc = '条件：' + reqText(e.req)
        note = e.desc || ''
      }
      out.push({ id: e.id, locked: false, show: show, desc: desc, note: note, rarity: e.rarity || e.rank || 1 })
    }
    this.setPool(out)
  },

  applyFilter(list) {
    if (this.flt === 'all' || this.tab === 'E' || this.tab === 'P') return list
    const want = this.flt === 'got' ? false : true    // 已得 → locked=false，未得 → locked=true
    return list.filter(x => x.locked === want)
  },

  /** 换一批数据，回到第 1 页 */
  setPool(list) {
    this.pool = this.applyFilter(list)
    this.pg = 0
    this.showPage()
  },

  /** 只把当前页切给界面渲染 */
  showPage() {
    const total = Math.max(1, Math.ceil(this.pool.length / PAGE_SIZE))
    if (this.pg > total - 1) this.pg = total - 1
    if (this.pg < 0) this.pg = 0
    const from = this.pg * PAGE_SIZE
    this.pageList = this.pool.slice(from, from + PAGE_SIZE)
    this.showPager = this.pool.length > PAGE_SIZE
    this.pageText = this.pool.length ? ((this.pg + 1) + ' / ' + total + ' 页') : '暂无'
  },

  prevPage() {
    if (this.pg <= 0) return
    this.$app.$def.tap()
    this.pg--
    this.showPage()
  },

  nextPage() {
    if ((this.pg + 1) * PAGE_SIZE >= this.pool.length) return
    this.$app.$def.tap()
    this.pg++
    this.showPage()
  },

  clearSeen() {
    this.$app.$def.tap()
    const app = this.$app.$def
    app.codexSeen = { T: [], I: [], D: [], A: [], P: [] }
    saveKey('lr_codex', JSON.stringify(app.codexSeen), null)
    this.rebuild()
  },

  back() { router.back() }
}
</script>

<style>
  @import '../../common/style/base.css';

  .tabs {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: 4px;
  }

  /* 6 个标签：28×6 = 168px，装得进 176px 可用宽度 */
  .tab {
    width: 28px;
    height: 34px;
    border-radius: 8px;
    background-color: rgba(120, 120, 121, 0.22);
    align-items: center;
    justify-content: center;
  }

  .tab-on { background-color: rgba(76, 175, 80, 0.8); }
  .tab-t { color: #f0e6d2; }

  .filters {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .filter {
    width: 50px;
    height: 24px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 12px;
    background-color: rgba(120, 120, 121, 0.22);
    align-items: center;
    justify-content: center;
  }

  .filter-on { background-color: rgba(201, 168, 106, 0.9); }
  .filter-t { color: #f0e6d2; }

  .status { width: 100%; height: 18px; align-items: center; justify-content: center; flex-shrink: 0; }

  .scroll { width: 100%; flex: 1; flex-direction: column; }

  .row {
    width: 100%;
    flex-direction: column;
    padding-top: 3px;
    padding-bottom: 3px;
  }

  .row-name { width: 100%; }
  .row-desc { width: 100%; }
  .row-note { width: 100%; }

  .pager {
    width: 100%;
    height: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .pg-btn {
    width: 64px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(201, 168, 106, 0.88);
    align-items: center;
    justify-content: center;
  }

  .pg-t { color: #2b1d0e; }
  .pg-n { color: #8b8f96; }

  .r1 { color: #c8cdd4; }
  .r2 { color: #6fcf97; }
  .r3 { color: #bb86fc; }
  .r4 { color: #ffc857; }
  .r5 { color: #ffc857; }
  .locked { color: #565b63; }
</style>
